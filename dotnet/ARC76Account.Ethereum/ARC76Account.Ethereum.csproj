<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>ARC76 Account - Ethereum</Title>
		<Description>Deterministic ARC76 account derivation for Ethereum and other EVM-compatible chains.</Description>
		<PackageTags>Ethereum;EVM;ARC76;Account generation</PackageTags>
		<PackageId>ARC76Account.Ethereum</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Nethereum.Signer" Version="6.1.0" />
		<!-- Direct reference to raise the transitive Newtonsoft.Json floor above the version
		     Nethereum.Signer 6.1.0 itself declares (11.0.2, GHSA-5crp-9r3c-p9vr, High) - see
		     audits/2026-08-03-audit-report.md. Nethereum.Signer has no newer release available
		     that fixes this itself. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ARC76Account.Core\ARC76Account.Core.csproj" />
	</ItemGroup>

</Project>
